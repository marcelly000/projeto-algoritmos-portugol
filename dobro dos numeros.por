programa
{
	
	funcao inicio()
	{
		inteiro v[8] , m, dobro
		para (inteiro i = 0; i < 8; i++)
		{
			m = i + 1
			escreva(m,"º Valor:")
			leia (v[i])
			dobro = v[i] * 2
			escreva(m,"º Valor é: ", v[i], " seu dobro é: ", dobro, "\n")
		}	
	}
}
